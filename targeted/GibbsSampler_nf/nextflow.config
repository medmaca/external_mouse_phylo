//
// nextflow.config
//
// Top-level configuration for the deep-seq Gibbs sampler pipeline. Defines all
// pipeline params with sensible defaults, enables Apptainer, sets resource
// ceilings, and provides a local and a SLURM institutional profile.

manifest {
    name            = 'deep-seq-gibbs'
    description      = 'Phylogenetic VAF Gibbs sampler wrapped for batch execution'
    mainScript      = 'main.nf'
    nextflowVersion  = '>=23.04.0'
    version          = '0.1.0'
}

params {
    // Input and output
    sample_sheet = null
    outdir       = 'results'

    // Container. Apptainer pulls and converts this Docker image on the HPC.
    container = 'docker://mcare/deep-seq-gibbs:0.1.0'

    // Sampler parameters (previously hardcoded in wrap_gibbs.jl)
    iter               = 20000
    burn_in            = 10000
    thin               = 100
    scale_pm           = 50
    min_vaf            = 1e-10
    seed               = 42
    ctrl_cov_threshold = 20
    flat_error         = 0.01

    // Resource ceilings, consumed by check_max() below
    max_memory  = '16.GB'
    max_cpus    = 4
    max_time    = '24.h'
    max_retries = 3

    hpc_account = "biol-tf-2018"
}

// Apptainer is the container engine. Docker images are built locally and pushed,
// then pulled and converted by Apptainer on the cluster.
apptainer.enabled    = true
apptainer.autoMounts = true

includeConfig 'conf/base.config'

profiles {
    standard {
        process.executor = 'local'
    }
    viking2 {
        // SLURM institutional profile. Adjust queue, account and QoS to suit your
        // allocation; the standards note this is the easiest part to edit by hand.
        process.executor = 'slurm'
        queueSize = 200
        submitRateLimit = "10/1sec"
        exitReadTimeout = "30 min"
        jobName = {
            task.name // [] and " " not allowed in lsf job names
                .replace("[", "(")
                .replace("]", ")")
                .replace(" ", "_")
        }
        process.clusterOptions = "--account=${params.hpc_account}"
    }
}

// Run reports
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html" }

// Clamp a requested resource to the configured ceiling. This is the nf-core
// check_max idiom; it is used in place of the illustrative Math.min snippet in
// the standards because it handles the MemoryUnit and Duration types correctly.
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "WARNING: max_memory '${params.max_memory}' is invalid; ignoring the ceiling"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "WARNING: max_time '${params.max_time}' is invalid; ignoring the ceiling"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min(obj as int, params.max_cpus as int)
        } catch (all) {
            println "WARNING: max_cpus '${params.max_cpus}' is invalid; ignoring the ceiling"
            return obj
        }
    } else {
        return obj
    }
}
