//
// conf/base.config
//
// Default execution settings: the retry error strategy required by the standards,
// and per-label resources. Resources scale on retry (task.attempt) and are clamped
// to the params.max_* ceilings via check_max(), which is defined in nextflow.config.

process {
    errorStrategy = 'retry'
    maxRetries    = params.max_retries

    withLabel: process_gibbs {
        // The sampler is single-threaded, so one CPU is sufficient. cpus is not
        // scaled; memory and time grow with each retry to ride out transient
        // shortfalls, clamped to the configured ceilings.
        cpus   = 1
        memory = { check_max( 4.GB * task.attempt, 'memory' ) }
        time   = { check_max( 4.h  * task.attempt, 'time'   ) }
    }
}
